# Copy to .env and fill in at least TELEPORT_PROXY_ADDR before running
# ./setup.sh. Everything else has a working default matching what the
# charts and teleport/*.yaml files already assume.

# --- Unique suffix ------------------------------------------------------
# Appended to every Teleport role/bot/workload_identity name, the
# Kubernetes namespace, the demo-grouping label, and every Helm release
# name below -- so this demo can be installed more than once against the
# SAME Teleport cluster and Kubernetes cluster without colliding.
# Teleport roles/bots/workload_identity resources aren't namespaced, so
# a cluster anyone else also uses will already have "postgres-wi-demo-cli"
# etc. claimed by the first person who ran this.
#
# Leave blank: setup.sh generates a random 4-character one on first run
# and writes it back into THIS FILE, so re-runs (and teardown.sh) keep
# reusing the same names instead of orphaning a previous run's
# resources. Set it yourself (e.g. your username) if you'd rather pin a
# specific value.
SUFFIX=

# --- Teleport cluster -------------------------------------------------
# e.g. example.teleport.sh:443. setup.sh assumes you're already logged
# in (`tsh login --proxy=...`) and that `tctl` is usable against this
# cluster -- it does not attempt to log in for you.
TELEPORT_PROXY_ADDR=example.teleport.sh:443

# --- Kubernetes ---------------------------------------------------------
NAMESPACE=postgres-wi-demo-${SUFFIX}

# --- Resource names -----------------------------------------------------
# Keep these consistent with each other; setup.sh substitutes them into
# teleport/*.yaml and passes them to the Helm charts via --set.
WORKLOAD_IDENTITY_NAME=postgres-demo-client-${SUFFIX}
POSTGRES_DB_USER=app_user
BOT_NAME=postgres-wi-tbot-${SUFFIX}
APP_NAME=postgres-${SUFFIX}
CLI_ROLE_NAME=postgres-wi-demo-cli-${SUFFIX}
SVID_SECRET_NAME=postgres-wi-svid-${SUFFIX}
SPIFFE_CA_SECRET_NAME=teleport-spiffe-ca-${SUFFIX}
# Value of the "demo" label every role/app/workload_identity/db resource
# is matched against (see teleport/*.yaml) -- suffixed too, so e.g.
# role-human-cli.yaml's workload_identity_labels/app_labels match ONLY
# this install's resources, not every install sharing the cluster.
DEMO_LABEL_VALUE=postgres-workload-identity-${SUFFIX}

# --- tbot -----------------------------------------------------------
# Must match your Teleport cluster's version. Leave unset and setup.sh
# detects it for you from https://$TELEPORT_PROXY_ADDR/webapi/ping
# (server_version). Only set this if you need to pin a specific tbot
# version instead, e.g.:
# TBOT_IMAGE_TAG=18.10.4
# How long the one-time join token setup.sh generates stays valid. It's
# only needed for tbot's very first join (see tbot-chart/values.yaml),
# so this just needs to comfortably outlast one `helm upgrade` run.
JOIN_TOKEN_TTL=4h

# --- Teleport agent (registers Postgres as a TCP Application, and --
# if ENABLE_DB_SERVICE=true -- a Database Access target) -------------
# setup.sh deploys the official teleport-kube-agent chart for this by
# default. Set to false if you'd rather merge
# teleport/app-service-teleport-config.yaml (and
# db-service-teleport-config.yaml) into an agent you already run.
DEPLOY_TELEPORT_AGENT=true
# NOT just "teleport-agent": the teleport-kube-agent chart names its
# ClusterRole/ClusterRoleBinding after the release name, and those are
# cluster-scoped (not namespaced) -- on a cluster anyone else also uses,
# "teleport-agent" is the first name everyone reaches for, so it's
# very likely already claimed by someone else's release in a different
# namespace, and `helm install` will fail with an ownership-metadata
# error rather than colliding silently. The ${SUFFIX} below handles
# this for you; only pick something else if that default still collides.
TELEPORT_AGENT_RELEASE=postgres-wi-demo-agent-${SUFFIX}
# Automatic agent updates (the agent's `updater.enabled`) -- on by
# default so you don't have to manually bump this alongside your
# cluster's version. Set to false to manage the agent's version
# yourself.
AGENT_AUTO_UPGRADE=true

# --- Optional: plain Teleport Database Access + automatic Postgres user
# provisioning, alongside the Workload Identity path. See
# teleport/README.md. Set to false and re-run setup.sh to tear this path
# down without affecting the Workload Identity side.
ENABLE_DB_SERVICE=true
DB_CLIENT_CA_SECRET_NAME=teleport-db-client-ca-${SUFFIX}

# --- Deploy the Python and/or Go client Jobs. On by default -- set
# either to false to skip that language. No registry needed: each Job
# self-compiles from its own bundled source in a stock `ubuntu` image at
# container start (confirmed working locally and against a live
# cluster). Only set CLIENT_IMAGE_REGISTRY if you'd rather build+push a
# real pre-built image per clients/*/Dockerfile instead (faster Job
# startup, at the cost of needing somewhere to push to).
DEPLOY_PYTHON_CLIENT=true
DEPLOY_GO_CLIENT=true
CLIENT_IMAGE_REGISTRY=
CLIENT_IMAGE_TAG=0.1.0
