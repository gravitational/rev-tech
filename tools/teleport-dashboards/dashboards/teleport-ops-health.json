{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Teleport ops/SRE health dashboard. What would page me at 2am? Pod health, backend latency (Postgres backend vs in-memory cache shown separately), Postgres/CNPG (single instance, no failover \u2014 durability is WAL archiving), audit + S3 pipeline, and resource pressure.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Teleport Metrics Reference",
      "tooltip": "",
      "type": "link",
      "url": "https://goteleport.com/docs/reference/monitoring/metrics/"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "CNPG Monitoring",
      "tooltip": "",
      "type": "link",
      "url": "https://cloudnative-pg.io/documentation/current/monitoring/"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Cluster Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of ALL Prometheus scrape targets in the Teleport namespace that are up. Anchored on namespace rather than $teleport_job so the CNPG Postgres exporter target (job=\"teleport/teleport-postgres\", which feeds the entire Postgres row) is included \u2014 it does not export teleport_build_info and was previously invisible here. NOTE: an average only covers targets that still exist; a target that disappears entirely (e.g. Deployment scaled to 0) will not pull this down \u2014 watch the Scraped Targets count next to it for that.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(up{namespace=~\"$namespace\"})",
          "legendFormat": "Targets Up",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Teleport Targets Up",
      "type": "stat",
      "x-requires": [
        "prometheus"
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Absolute count of scrape targets currently up in the Teleport namespace. Expected: 7 (2 proxy, 1 auth, ssh-node, grafana-agent, prometheus-agent, postgres exporter). Unlike the percentage next to it, this goes DOWN when a target vanishes from Prometheus entirely. Not scraped at all today, so not counted here: teleport-access-graph, tbot, approval-bot, usage-tracker.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "green",
                "value": 7
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(up{namespace=~\"$namespace\"} == 1)",
          "legendFormat": "Targets Scraped",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Scraped Targets Up (count)",
      "type": "stat",
      "x-requires": [
        "prometheus"
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Left column: restarts that happened inside the selected dashboard time range. Right column: lifetime restart counter for the container as it stands right now. Both are filtered to > 0 so healthy pods do not bury the signal. The lifetime column is the one to trust: a restart older than the dashboard window, or one belonging to a pod that has since been replaced (a replacement pod is a brand new series starting at 0), is invisible in the range column.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[$__range])) > 0",
          "legendFormat": "__auto",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (pod, container) (kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}) > 0",
          "legendFormat": "__auto",
          "refId": "B",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "title": "Container Restarts",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "pod": "Pod",
              "container": "Container",
              "Value #A": "Restarts in range",
              "Value #B": "Restarts (lifetime)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": true,
                "field": "Restarts (lifetime)"
              }
            ]
          }
        }
      ],
      "type": "table",
      "x-requires": [
        "kubeStateMetrics"
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 101,
      "panels": [],
      "title": "Backend Performance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Backend write latency, split by `component`. `backend` is the real Postgres backend (auth only); `cache` is Teleport's in-memory cache. These were previously summed together, which averaged Postgres latency down toward cache latency and made it impossible to tell which one was slow. Sustained P99 > 100ms on the `backend` series warrants investigation. Caveat: ~100% of `cache` writes fall in the first histogram bucket (le=1ms), so all three cache percentiles are interpolation inside [0, 1ms] \u2014 read them as \"below resolution\", not as measurements.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(backend_write_seconds_bucket{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m])) by (le, component))",
          "legendFormat": "P50 {{component}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(backend_write_seconds_bucket{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m])) by (le, component))",
          "legendFormat": "P95 {{component}}",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(backend_write_seconds_bucket{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m])) by (le, component))",
          "legendFormat": "P99 {{component}}",
          "refId": "C",
          "range": true
        }
      ],
      "title": "Backend Write Latency (P50/P95/P99)",
      "type": "timeseries",
      "x-requires": [
        "prometheus"
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Backend read latency, split by `component`. `backend` is the real Postgres backend (auth only); `cache` is Teleport's in-memory cache. Previously these were summed into one line, so the panel's own question \u2014 \"is this cache pressure or Postgres slowness?\" \u2014 could not be answered from it. P50 has been REMOVED deliberately: ~94% of `backend` reads and 100% of `cache` reads land in the first histogram bucket (le=1ms), so any median would be linear interpolation inside [0, 1ms] with no underlying observation to support it. For the same reason treat the `cache` P95/P99 as \"sub-millisecond\" rather than as exact values.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(backend_read_seconds_bucket{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m])) by (le, component))",
          "legendFormat": "P95 {{component}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(backend_read_seconds_bucket{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m])) by (le, component))",
          "legendFormat": "P99 {{component}}",
          "refId": "B",
          "range": true
        }
      ],
      "title": "Backend Read Latency (P95/P99)",
      "type": "timeseries",
      "x-requires": [
        "prometheus"
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Backend request throughput split by `component`. Summing `backend` and `cache` together inflated apparent Postgres load (measured: reads/s backend-only 2.04 vs 3.13 mixed). The `backend` series is the load actually reaching Postgres; `cache` never touches the database. Sudden spikes in backend writes often indicate a heartbeat storm.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (component) (rate(backend_write_requests_total{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m]))",
          "legendFormat": "Writes/s {{component}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (component) (rate(backend_read_requests_total{namespace=~\"$namespace\",job=~\"$teleport_job\"}[5m]))",
          "legendFormat": "Reads/s {{component}}",
          "refId": "B",
          "range": true
        }
      ],
      "title": "Backend Ops/sec (Writes vs Reads, by component)",
      "type": "timeseries",
      "x-requires": [
        "prometheus"
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 102,
      "panels": [],
      "title": "Postgres (CNPG)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Streaming replication lag \u2014 ONLY shown when a streaming standby actually exists. This CNPG cluster runs spec.instances: 1, so cnpg_pg_replication_streaming_replicas = 0 and there is no failover target. Ungated, cnpg_pg_replication_lag reports a flat 0 and painted the panel permanently green, which read as \"healthy HA pair\" when the truth is \"single Postgres pod, no replica, no automatic failover\". The `and on()` guard makes it render \"No standby configured\" instead. Durability on this cluster comes from WAL archiving \u2014 see the panel to the right.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "s",
          "noValue": "No standby configured"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "id": 6,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(cnpg_pg_replication_lag{namespace=~\"$namespace\"}) and on() (cnpg_pg_replication_streaming_replicas{namespace=~\"$namespace\"} > 0)",
          "legendFormat": "Replication Lag",
          "refId": "A",
          "range": true
        }
      ],
      "title": "Postgres Replication Lag",
      "type": "gauge",
      "x-requires": [
        "cnpg"
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The actual durability guarantee for this single-instance Postgres cluster: WAL archiving to object storage. With no standby, point-in-time recovery from archived WAL is the only recovery path \u2014 if archiving stalls, unarchived writes are lost on node failure. \"Archive Failures\" is a lifetime counter (non-zero is normal after a restart; a rising value is not). \"Since Last Archive\" climbing without bound means archiving has stopped.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since Last Archive"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 900
                    },
                    {
                      "color": "red",
                      "value": 3600
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Archive Failures (lifetime)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 25
      },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
