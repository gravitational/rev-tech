{
  "uid": "selftest",
  "title": "Harness self-test",
  "schemaVersion": 39,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query"
      },
      {
        "name": "teleport_job",
        "type": "query"
      },
      {
        "name": "DS_UNPINNED",
        "type": "datasource",
        "query": "postgres",
        "regex": "",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "skipUrlSync": false,
        "description": "BUG S6: a postgres datasource variable with neither a regex nor a pinned value. Grafana autobinds to whichever postgres datasource sorts first, so a panel can silently query the wrong database and return plausible rows."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "BUG L1 increase on a gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(teleport_incomplete_session_uploads_total{namespace=~\"$namespace\"}[15m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "BUG L2 window beyond retention",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(audit_failed_emit_events{namespace=~\"$namespace\"}[90d]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "BUG L3 count over kube condition",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "BUG D3 NaN ratio (deterministic 0/0)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vector(0) / vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "BUG S3 undeclared var",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(up{namespace=~\"$nope_not_declared\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "BUG S2 overlaps panel 5",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 3,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vector(1)"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "BUG S5 dangling drill-down",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "links": [
        {
          "title": "go nowhere",
          "url": "/d/this-uid-does-not-exist/whatever"
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "vector(1)"
        }
      ]
    }
  ]
}